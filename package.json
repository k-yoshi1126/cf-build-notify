{
	"name": "cf-build-notify",
	"private": true,
	"type": "module",
	"description": "Workers Builds の本番成功・失敗を Slack に通知する Queue consumer。",
	"scripts": {
		"cf-typegen": "wrangler types --include-runtime false",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm test"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261112.1",
		"@types/node": "^22.20.5",
		"typescript": "5.9.3",
		"vitest": "4.1.10",
		"wrangler": "4.136.1"
	}
}
